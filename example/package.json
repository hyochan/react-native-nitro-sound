{
  "name": "react-native-nitro-sound-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:select": "node scripts/ios-select.js",
    "ios:pod": "cd ios && pod install --repo-update && cd ..",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Release --scheme SoundExample",
    "web": "webpack serve --mode development",
    "build:web": "webpack --mode production"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-nitro-sound": "*",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-video": "^6.19.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.29.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "^19.2.18",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-native-web": "^0.21.2",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.8",
    "react-native-builder-bob": "^0.43.0",
    "react-native-monorepo-config": "^0.4.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
