{
  "name": "react-native-nitro-sound",
  "version": "0.2.18",
  "description": "React Native Sound Module 🔥 by Nitro",
  "homepage": "https://github.com/hyochan/react-native-nitro-sound",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js",
      "react-native": "./src/index.tsx",
      "browser": "./lib/module/index.web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-nitro-sound-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "husky && tsx scripts/check-nitro-versions.ts && bob build",
    "nitrogen": "nitrogen && ./scripts/fix-nitrogen-swift.sh",
    "release": "release-it --only-version",
    "web": "yarn workspace react-native-nitro-sound-example web",
    "build:web": "yarn workspace react-native-nitro-sound-example build:web",
    "android": "yarn workspace react-native-nitro-sound-example android",
    "ios": "yarn workspace react-native-nitro-sound-example ios",
    "start": "yarn workspace react-native-nitro-sound-example start",
    "logcat": "adb logcat -c && adb logcat --pid=$(adb shell pidof sound.example)"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyochan/react-native-nitro-sound.git"
  },
  "author": "hyochan <hyo@hyo.dev> (https://github.com/hyochan)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hyochan/react-native-nitro-sound/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@evilmartians/lefthook": "^2.1.10",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "^0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "expo": "^57.0.11",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nitrogen": "0.36.5",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-builder-bob": "0.43.0",
    "react-native-nitro-modules": "0.36.5",
    "release-it": "^21.0.1",
    "tsx": "^4.23.10",
    "turbo": "^2.10.8",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5"
  },
  "resolutions": {
    "eslint-plugin-ft-flow": "^3.0.11"
  },
  "workspaces": [
    "example"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "packageManager": "yarn@4.18.0",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-swift",
    "type": "nitro-module",
    "version": "0.51.1"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.2.0"
  }
}
